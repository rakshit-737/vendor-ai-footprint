# Copy to .env (never committed) and fill in.
# Google Gemini API key (AI Studio). Only public vendor text is ever sent to Gemini.
GEMINI_API_KEY=
# Contact email for the User-Agent that the SEC fair-access policy requires on EDGAR requests.
FOOTPRINT_SEC_CONTACT=
# Shown in column V ("Assessed By / Date") and on the deck.
FOOTPRINT_TEAM_NAME=Team TBD
# Windows consoles default to cp1252; force UTF-8 so excerpts and arrows print correctly.
PYTHONUTF8=1
